{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"  // ⬅️ This is crucial for APK
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"  // ⬅️ For production APK
      }
    }
  },
  "submit": {
    "production": {}
  }
}